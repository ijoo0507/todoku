# Copy to .env.local and fill in. Never commit real values.

# Neon Postgres
DATABASE_URL=

# NextAuth (Google)
AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Public site URL, used for share links and OG images
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# PostHog project API key (analytics no-ops when empty)
NEXT_PUBLIC_POSTHOG_KEY=

# Upstash Redis: rate limiting + analysis cache (both fail open when empty)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
